# Copy to .env and adjust. The values below match the Postgres service in the root docker-compose.yml.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sonora?schema=public"

# Optional
# PORT=4000
# Where project snapshots are stored (default: apps/api/.data/storage). Delete this folder to reset all saved songs.
# STORAGE_DIR=./.data/storage
# "file" (default, survives restarts) or "memory" (tests only: everything is lost on restart)
# STORAGE_DRIVER=file
